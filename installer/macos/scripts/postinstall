#!/bin/bash
# Apple Installer postinstall — runs as root. Copy payload into the console user's home.
set -euo pipefail

PAYLOAD="/Library/Application Support/yaaif/cursor-plugin"
INSTALL_SH="$PAYLOAD/lib/install.sh"

if [[ ! -x "$INSTALL_SH" ]]; then
  echo "postinstall: missing $INSTALL_SH" >&2
  exit 1
fi

TARGET_USER="${YAAIF_INSTALL_USER:-}"
if [[ -z "$TARGET_USER" ]]; then
  CONSOLE_USER="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
  if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" && "$CONSOLE_USER" != "loginwindow" ]]; then
    TARGET_USER="$CONSOLE_USER"
  elif [[ -n "${USER:-}" && "${USER}" != "root" ]]; then
    TARGET_USER="$USER"
  else
    echo "postinstall: cannot determine the logged-in user" >&2
    exit 1
  fi
fi

HOME_DIR="$(dscl . -read "/Users/${TARGET_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
if [[ -z "$HOME_DIR" || ! -d "$HOME_DIR" ]]; then
  echo "postinstall: cannot resolve home for $TARGET_USER" >&2
  exit 1
fi

exec "$INSTALL_SH" --payload "$PAYLOAD" --user "$TARGET_USER" --home "$HOME_DIR"
