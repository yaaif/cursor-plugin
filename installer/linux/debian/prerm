#!/bin/sh
set -e
# Remove the user plugin copy. Keep ~/.yaaif/cursor session/profiles/CA.
# dpkg then removes /opt/yaaif/cursor-plugin.

UNINSTALL="/opt/yaaif/cursor-plugin/lib/uninstall.sh"
if [ ! -x "$UNINSTALL" ]; then
  exit 0
fi

TARGET_USER="${YAAIF_INSTALL_USER:-}"
if [ -z "$TARGET_USER" ]; then
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    TARGET_USER="$SUDO_USER"
  elif [ -n "${USER:-}" ] && [ "$USER" != "root" ]; then
    TARGET_USER="$USER"
  fi
fi

if [ -n "$TARGET_USER" ]; then
  HOME_DIR="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
  if [ -n "$HOME_DIR" ]; then
    "$UNINSTALL" --user "$TARGET_USER" --home "$HOME_DIR" --user-files-only || true
  fi
fi
exit 0
