#!/bin/sh
set -e

PAYLOAD="/opt/yaaif/cursor-plugin"
INSTALL_SH="$PAYLOAD/lib/install.sh"

if [ ! -x "$INSTALL_SH" ]; then
  echo "yaaif-cursor-plugin: missing $INSTALL_SH" >&2
  exit 1
fi

TARGET_USER="${YAAIF_INSTALL_USER:-}"
if [ -z "$TARGET_USER" ]; then
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    TARGET_USER="$SUDO_USER"
  elif [ -n "${USER:-}" ] && [ "$USER" != "root" ]; then
    TARGET_USER="$USER"
  else
    echo "yaaif-cursor-plugin: cannot determine the installing user (set YAAIF_INSTALL_USER)" >&2
    exit 1
  fi
fi

HOME_DIR="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
if [ -z "$HOME_DIR" ] || [ ! -d "$HOME_DIR" ]; then
  echo "yaaif-cursor-plugin: cannot resolve home for $TARGET_USER" >&2
  exit 1
fi

"$INSTALL_SH" --payload "$PAYLOAD" --user "$TARGET_USER" --home "$HOME_DIR"
