# Keycloak / OIDC (public client yaaif-cursor)
YAAIF_OIDC_AUTHORITY=http://localhost:8080/auth/realms/yaaif
YAAIF_OIDC_CLIENT_ID=yaaif-cursor
YAAIF_OIDC_SCOPES=openid profile email offline_access

# Platform API bases (no trailing slash required)
YAAIF_API_BASE_URL=http://localhost:8084
YAAIF_AGENT_BASE_URL=http://localhost:8086

# Optional default tenant UUID after login
YAAIF_DEFAULT_TENANT_ID=

# Token cache directory (default: ~/.yaaif/cursor)
# YAAIF_CURSOR_HOME=
